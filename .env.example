# Kampus.VC Environment Configuration Example

# ==========================
# Application Environment
# ==========================
NODE_ENV=development

# ==========================
# Frontend Configuration (Exposed via Vite)
# ==========================
VITE_API_BASE_URL=http://localhost:4000/api
VITE_APP_NAME="Kampus.VC"
VITE_ENABLE_DEMO_MODE=true

# ==========================
# Backend Configuration (Server-Only Secrets)
# ==========================
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=debug

# Database (MongoDB connection)
MONGODB_URI=mongodb://localhost:27017/kampus-vc

# Authentication & Session (Phase 2 & Google OAuth)
SESSION_SECRET=your-cryptographic-session-secret-min-32-chars
SESSION_COOKIE_NAME=kampus_session
SESSION_TTL_HOURS=72
COOKIE_SECURE=false

# Google OAuth 2.0 (Google Sign-In)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ==========================
# Phase 5: AI Creative Studio
# ==========================
# Provider selection: 'gemini' | 'mock' | 'none'
AI_PROVIDER=gemini
AI_API_KEY=your-gemini-api-key-here
AI_TEXT_MODEL=gemini-2.0-flash
AI_VISION_MODEL=gemini-2.0-flash
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=2048
AI_DAILY_USER_LIMIT=50

# ==========================
# Phase 7: Media Storage & Object Storage
# ==========================
# Provider selection: 'local' | 's3' | 'cloudinary'
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_LOCAL_DIR=./uploads
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_VIDEO_BYTES=104857600
MEDIA_UPLOAD_URL_TTL_SECONDS=900
MEDIA_ACCESS_URL_TTL_SECONDS=3600

# Cloudinary Object Storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name

# S3 / S3-Compatible Storage (AWS S3, Cloudflare R2, MinIO)
# MEDIA_BUCKET=kampus-media-assets
# MEDIA_REGION=us-east-1
# MEDIA_ACCESS_KEY_ID=your-access-key-id
# MEDIA_SECRET_ACCESS_KEY=your-secret-access-key
# MEDIA_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# MEDIA_S3_FORCE_PATH_STYLE=false

# ==========================
# Phase 9: Payment Integration & Financial Ledger (Razorpay)
# ==========================
# Payment provider: 'razorpay' | 'mock'
PAYMENT_PROVIDER=razorpay
RAZORPAY_ENVIRONMENT=test
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# Public key for frontend
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
